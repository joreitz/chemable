{
  "name": "chemable",
  "version": "1.0.8",
  "description": "A 2D Chemical Drawing Editor",
  "main": "dist/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/joreitz/chemable.git"
  },
"scripts": {
    "build": "tsc",
    "start": "tsc && electron dist/main.js",
    "pack": "tsc && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "tsc && electron-builder --publish always"
  },
  "author": "Joshua Reitz",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.9.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "jspdf": "^4.2.0",
    "svg2pdf.js": "^2.7.0"
  },
  "build": {
    "appId": "com.joreitz.chemable",
    "productName": "Chemable",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Science"
    },
    "publish": [
      "github"
    ],
    "extraResources": [
      {
        "from": "bin/${os}",
        "to": "external-bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}