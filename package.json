{
  "name": "chemable",
  "version": "1.0.1",
  "description": "2D Chemical Drawing Editor",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron dist/main.js",
    "pack": "tsc && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "author": "Joshua Reitz",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.9.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "jspdf": "^4.2.0",
    "svg2pdf.js": "^2.7.0"
  },
  "build": {
    "appId": "com.joreitz.chemable",
    "productName": "Chemable",
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": "tar.gz",
      "category": "Science"
    },
    "extraResources": [
      {
        "from": "bin/${os}",
        "to": "external-bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
